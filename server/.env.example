# Server
NODE_ENV=development
PORT=4000
# Comma-separated production/preview origins allowed by CORS (e.g. your Vercel
# client URL). Any http(s)://localhost:* or 127.0.0.1:* origin is always allowed
# on top of this, so local frontend dev works without touching this value.
CLIENT_ORIGIN=https://your-client.vercel.app

# MongoDB Atlas connection string (Database > Connect > Drivers).
# Required when deploying to Vercel: serverless functions are stateless between
# invocations, so without Atlas the in-memory store resets on every cold start.
MONGODB_URI=

# JWT secrets — MUST be >= 32 chars each. Generate with:
#   node -e "console.log(crypto.randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Assistant LLM — Google Gemini (https://aistudio.google.com/app/apikey).
# Blank = the assistant uses its grounded keyword fallback (still works).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Voyage AI embeddings (for future vector search)
VOYAGE_API_KEY=

# Cloudinary (Dashboard > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin — enables POST /auth/google ("Sign in with Google").
# Firebase console > Project settings > Service accounts > Generate new private key.
# Put the private key on one line, keeping the literal \n sequences, wrapped in quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
