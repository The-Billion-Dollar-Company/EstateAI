# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=

# JWT secrets — generate with: node -e "console.log(crypto.randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# AI providers
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Cloudinary (Dashboard > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
